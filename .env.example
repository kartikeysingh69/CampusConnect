# CampusConnect Environment Configuration Template
# Copy this file to .env and update values for your environment

# Server Config
PORT=5001

# Database Config (MySQL)
# Docker Compose maps MySQL to host port 3307; native MySQL typically uses 3306
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=campusconnect

# JWT Secret (use a strong random value in production)
JWT_SECRET=campusconnect_super_secret_key_change_me

# App Environment
NODE_ENV=development
APP_URL=http://localhost

# Optional SMTP Config for Interview & Offer Emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=placements@campusconnect.edu
# SMTP_PASS=your_app_password
