# ==============================================================================
# infra/aws/terraform/versions.tf — Terraform & Provider Pinning
# Ensures reproducible builds across developer laptops and CI/CD runners.
# ==============================================================================

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = local.common_tags
  }
}
