# ==============================================================================
# infra/aws/terraform/terraform.tfvars.example
# Copy to terraform.tfvars to override defaults for Staging / Production.
# ==============================================================================

aws_region     = "us-east-1"
project_name   = "CampusConnect"
environment    = "production"
instance_type  = "t3.micro"
key_name       = "campusconnect-key"
s3_bucket_name = "campusconnect-storage-343980058788"
