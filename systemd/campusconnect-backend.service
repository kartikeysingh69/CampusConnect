[Unit]
Description=CampusConnect Enterprise Placement Backend Service
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=campusconnect
Group=campusconnect
WorkingDirectory=/opt/campusconnect
ExecStart=/usr/bin/node /opt/campusconnect/backend/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
EnvironmentFile=-/etc/campusconnect/backend.env

# Standard logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=campusconnect-backend

# Security Sandboxing for Linux Production Daemon
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
